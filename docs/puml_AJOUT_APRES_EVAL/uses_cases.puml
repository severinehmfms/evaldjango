@startuml
'https://plantuml.com/use-case-diagram

left to right direction

actor Visiteur
actor "Utilisateur connecté" as User

rectangle "Application Entraide" {

    usecase "Consulter les créneaux" as UC1
    usecase "Se connecter" as UC2
    usecase "Proposer un créneau" as UC3
    usecase "Gérer ses compétences" as UC4
    usecase "Consulter les demandes d'aide" as UC5
    usecase "Accepter d'aider" as UC6
}

Visiteur --> UC1
Visiteur --> UC2

User --> UC1
User --> UC3
User --> UC4
User --> UC5
User --> UC6

@enduml
